00010011  // 0: LDI 3  - ACC = 3
00110000  // 1: STA 0  - mem[0] = 3
00010010  // 2: LDI 2  - ACC = 2
01000000  // 3: ADD 0  - ACC = 2 + 3 = 5
11010000  // 4: OUT    - output 0101
11100000  // 5: HLT
11100000  // padding: HLT so a runaway PC stops instead of fetching x
